let az=0 el=90 cover=1 mu=0.1 daz=0.16 del=0.14 dw=0.03 sx=27 sy=10 zt=222
part box parts/std/hammond_1550h.gcad body=main
if cover part lid parts/std/hammond_1550h.gcad body=lid
part ctl parts/ctl_board.gcad
rotate ctl -90 axis=x
move ctl 66,-37,89
part ctl_post_1 parts/std/standoff.gcad L=10 af=5.5 d=3 ff=1
material ctl_post_1 aluminium
rotate ctl_post_1 -90 axis=x
move ctl_post_1 -64,-26,79
part ctl_screw_1 parts/std/screw.gcad d=3 L=6
rotate ctl_screw_1 -90 axis=x
move ctl_screw_1 -64,-14.4,79
part ctl_seal_1 parts/std/screw.gcad d=3 L=8
rotate ctl_seal_1 90 axis=x
move ctl_seal_1 -64,-30,79
