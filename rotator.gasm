rotate ctl_screw_2 -90 axis=x
move ctl_screw_2 16,-14.4,79
part ctl_seal_2 parts/std/screw.gcad d=3 L=8
rotate ctl_seal_2 90 axis=x
move ctl_seal_2 16,-30,79
part ctl_post_3 parts/std/standoff.gcad L=10 af=5.5 d=3 ff=1
