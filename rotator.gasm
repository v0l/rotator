rotate ctl_screw_3 -90 axis=x
move ctl_screw_3 -64,-14.4,130.5
part ctl_seal_3 parts/std/screw.gcad d=3 L=8
rotate ctl_seal_3 90 axis=x
move ctl_seal_3 -64,-30,130.5
part ctl_post_4 parts/std/standoff.gcad L=10 af=5.5 d=3 ff=1
material ctl_post_4 aluminium
rotate ctl_post_4 -90 axis=x
move ctl_post_4 16,-26,129
part ctl_screw_4 parts/std/screw.gcad d=3 L=6
rotate ctl_screw_4 -90 axis=x
move ctl_screw_4 16,-14.4,129
part ctl_seal_4 parts/std/screw.gcad d=3 L=8
rotate ctl_seal_4 90 axis=x
move ctl_seal_4 16,-30,129
part cell_holder parts/std/cr123_holder.gcad body=main
rotate cell_holder -90 axis=x
move cell_holder -45,-26,190
part cell parts/std/cr123_holder.gcad body=cell
rotate cell -90 axis=x
move cell -45,-26,190
part cell_screw_1 parts/std/screwcsk.gcad d=3 L=8
rotate cell_screw_1 -90 axis=x
move cell_screw_1 -57.7,-24.1,190
part cell_nut_1 parts/std/nut.gcad d=3 af=5.5 m=2.4
rotate cell_nut_1 90 axis=x
move cell_nut_1 -57.7,-30,190
part cell_screw_2 parts/std/screwcsk.gcad d=3 L=8
rotate cell_screw_2 -90 axis=x
move cell_screw_2 -32.3,-24.1,190
part cell_nut_2 parts/std/nut.gcad d=3 af=5.5 m=2.4
rotate cell_nut_2 90 axis=x
move cell_nut_2 -32.3,-30,190
part eth_plug parts/std/rj45_lead.gcad body=main
move eth_plug -123,-23.8,39.64
rotate eth_plug -90 axis=x
move eth_plug 66,-37,89
part gland_1 parts/std/gland.gcad
rotate gland_1 180 axis=x
move gland_1 -58,0,0
part gland_2 parts/std/gland.gcad
rotate gland_2 180 axis=x
move gland_2 -32,0,0
part vent parts/std/vent.gcad
rotate vent 180 axis=x
move vent -45,-18,0
part mast parts/std/tube.gcad D=48.3 t=3.2 L=500
move mast 0,-60.15,-250
part saddle_1 parts/std/vsaddle.gcad
move saddle_1 0,-30,56
part ubolt_1 parts/std/ubolt.gcad d=8 a=29 L=42 nz=34.15 af=13 m=6.5
rotate ubolt_1 -90 axis=x
move ubolt_1 0,-60.15,56
part saddle_2 parts/std/vsaddle.gcad
move saddle_2 0,-30,170
part ubolt_2 parts/std/ubolt.gcad d=8 a=29 L=42 nz=34.15 af=13 m=6.5
rotate ubolt_2 -90 axis=x
move ubolt_2 0,-60.15,170
part kfl_low_bolt_1 parts/std/screw.gcad d=6 L=16
rotate kfl_low_bolt_1 180 axis=x
move kfl_low_bolt_1 sx-26.5,sy,0
part kfl_low_nut_1 parts/std/nut.gcad d=6 af=10 m=5
move kfl_low_nut_1 sx-26.5,sy,10.5
part kfl_up_bolt_1 parts/std/screw.gcad d=6 L=16
move kfl_up_bolt_1 sx-26.5,sy,zt
part kfl_up_nut_1 parts/std/nut.gcad d=6 af=10 m=5
move kfl_up_nut_1 sx-26.5,sy,zt-15.5
part kfl_low_bolt_2 parts/std/screw.gcad d=6 L=16
rotate kfl_low_bolt_2 180 axis=x
move kfl_low_bolt_2 sx+26.5,sy,0
part kfl_low_nut_2 parts/std/nut.gcad d=6 af=10 m=5
move kfl_low_nut_2 sx+26.5,sy,10.5
part kfl_up_bolt_2 parts/std/screw.gcad d=6 L=16
move kfl_up_bolt_2 sx+26.5,sy,zt
part kfl_up_nut_2 parts/std/nut.gcad d=6 af=10 m=5
move kfl_up_nut_2 sx+26.5,sy,zt-15.5
part drv_screw_1 parts/std/screw.gcad d=4 L=10
rotate drv_screw_1 180 axis=x
move drv_screw_1 sx-15,sy+30,0
part drv_screw_2 parts/std/screw.gcad d=4 L=10
rotate drv_screw_2 180 axis=x
move drv_screw_2 sx-15,sy+46,0
part drv_screw_3 parts/std/screw.gcad d=4 L=10
rotate drv_screw_3 180 axis=x
move drv_screw_3 sx-40.5,sy+26,0
part drv_screw_4 parts/std/screw.gcad d=4 L=10
rotate drv_screw_4 180 axis=x
move drv_screw_4 sx-40.5,sy+50,0
part base azstage.gasm dw=dw sx=sx sy=sy zt=zt
axis za sx,sy,0 sx,sy,1
joint az base.spindle box turn about=za min=-270 max=270 drag=daz
concentric drv_screw_1:shank.side base.drive.plates.base:fix1.side
concentric drv_screw_2:shank.side base.drive.plates.base:fix2.side
concentric drv_screw_3:shank.side base.drive.plates.base:fix3.side
concentric drv_screw_4:shank.side base.drive.plates.base:fix4.side
couple base.drive.spin az ratio=60 lead=3.583 friction=mu module=1/cos(3.583) face=10 pressure=20 gear=base.wheel pinion=base.drive.worm
pose az az
interference none
interference joint=az steps=18
