material hat_post_2 aluminium
rotate hat_post_2 -90 axis=x
move hat_post_2 -2.5,34.6,136.5
part hat_post_3 parts/std/standoff.gcad L=11 af=5 d=2.5 stud=4
material hat_post_3 aluminium
