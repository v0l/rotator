let az=0 el=90 eh=226 boom=500 cover=1 hammond=0 yx=300 yy=-402 yz=35 mu=0.1 daz=0.16 del=0.14 dw=0.03
part box parts/std/hammond_1550z220_box.gcad az=1 vendor=hammond
move box -40,0,0
if cover part lid parts/std/hammond_1550z220_lid.gcad az=1 vendor=hammond
if cover move lid -40,0,0
part ctl parts/ctl_board.gcad
part ctl_post_1 parts/std/standoff.gcad L=18 af=5.5 stud=6 d=3
material ctl_post_1 aluminium
move ctl_post_1 -130,10,3
part ctl_screw_1 parts/std/screw.gcad d=3 L=6
move ctl_screw_1 -130,10,22.6
part ctl_post_2 parts/std/standoff.gcad L=18 af=5.5 stud=6 d=3
material ctl_post_2 aluminium
move ctl_post_2 -50,10,3
part ctl_screw_2 parts/std/screw.gcad d=3 L=6
move ctl_screw_2 -50,10,22.6
part ctl_post_3 parts/std/standoff.gcad L=18 af=5.5 stud=6 d=3
material ctl_post_3 aluminium
move ctl_post_3 -130,-41.5,3
part ctl_screw_3 parts/std/screw.gcad d=3 L=6
move ctl_screw_3 -130,-41.5,22.6
part ctl_post_4 parts/std/standoff.gcad L=18 af=5.5 stud=6 d=3
material ctl_post_4 aluminium
move ctl_post_4 -50,-40,3
part ctl_screw_4 parts/std/screw.gcad d=3 L=6
move ctl_screw_4 -50,-40,22.6
part cell_holder parts/std/cr123_holder.gcad body=main
move cell_holder 0,-50,3
part cell parts/std/cr123_holder.gcad body=cell
move cell 0,-50,3
part cell_screw_1 parts/std/screwcsk.gcad d=3 L=8
move cell_screw_1 -12.7,-50,4.9
part cell_screw_2 parts/std/screwcsk.gcad d=3 L=8
move cell_screw_2 12.7,-50,4.9
part eth_plug parts/std/rj45_lead.gcad body=main
move eth_plug -123,-23.8,39.64
part eth_cable parts/std/rj45_lead.gcad body=cable
move eth_cable -123,-23.8,39.64
part mastclamp parts/mastclamp.gcad
part mast parts/std/tube.gcad D=48.3 t=3.2 L=300
move mast 0,0,-318
part vent_base parts/std/vent.gcad
rotate vent_base 90 axis=x
move vent_base 10,-73.25,30
part gland_base_1 parts/std/gland.gcad
rotate gland_base_1 -90 axis=y
move gland_base_1 -151.25,25,30
part gland_base_2 parts/std/gland.gcad
rotate gland_base_2 -90 axis=y
move gland_base_2 -151.25,-25,30
part base azstage.gasm dw=dw
part head head.gasm eh=eh hammond=hammond boom=boom cover=cover yx=yx yy=yy yz=yz dw=dw
part kfl_low_screw_1 parts/std/screw.gcad d=6 L=16
move kfl_low_screw_1 -26.5,0,9.5
part kfl_low_screw_2 parts/std/screw.gcad d=6 L=16
move kfl_low_screw_2 26.5,0,9.5
part blk_screw_az_1 parts/std/screw.gcad d=4 L=16
rotate blk_screw_az_1 90 axis=x
move blk_screw_az_1 8,23,-15
rotate blk_screw_az_1 90 axis=y
rotate blk_screw_az_1 -90 axis=x
move blk_screw_az_1 0,38,32
part blk_screw_az_2 parts/std/screw.gcad d=4 L=16
rotate blk_screw_az_2 90 axis=x
move blk_screw_az_2 -8,23,-15
rotate blk_screw_az_2 90 axis=y
rotate blk_screw_az_2 -90 axis=x
move blk_screw_az_2 0,38,32
part blk_screw_az_3 parts/std/screw.gcad d=4 L=16
rotate blk_screw_az_3 90 axis=x
move blk_screw_az_3 12,23,-40
rotate blk_screw_az_3 90 axis=y
rotate blk_screw_az_3 -90 axis=x
move blk_screw_az_3 0,38,32
part blk_screw_az_4 parts/std/screw.gcad d=4 L=16
rotate blk_screw_az_4 90 axis=x
move blk_screw_az_4 -12,23,-40
rotate blk_screw_az_4 90 axis=y
rotate blk_screw_az_4 -90 axis=x
move blk_screw_az_4 0,38,32
part collar_screw_1 parts/std/screwcsk.gcad d=4 L=16
rotate collar_screw_1 180 axis=x
move collar_screw_1 12.021,12.021,88
part collar_nut_1 parts/std/nut.gcad d=4 af=7 m=3.2
move collar_nut_1 12.021,12.021,99.2
part collar_screw_2 parts/std/screwcsk.gcad d=4 L=16
rotate collar_screw_2 180 axis=x
move collar_screw_2 -12.021,12.021,88
part collar_nut_2 parts/std/nut.gcad d=4 af=7 m=3.2
move collar_nut_2 -12.021,12.021,99.2
part collar_screw_3 parts/std/screwcsk.gcad d=4 L=16
rotate collar_screw_3 180 axis=x
move collar_screw_3 -12.021,-12.021,88
part collar_nut_3 parts/std/nut.gcad d=4 af=7 m=3.2
move collar_nut_3 -12.021,-12.021,99.2
part collar_screw_4 parts/std/screwcsk.gcad d=4 L=16
rotate collar_screw_4 180 axis=x
move collar_screw_4 12.021,-12.021,88
part collar_nut_4 parts/std/nut.gcad d=4 af=7 m=3.2
move collar_nut_4 12.021,-12.021,99.2
axis za 0,0,0 0,0,1
axis ea 0,0,eh 1,0,eh
joint az base.spindle box turn about=za min=-270 max=270 drag=daz
concentric head.elbox:spindle.side base.collar:bore.side
concentric collar_screw_1:screw base.collar:fix.side near=12.021,12.021,95
concentric collar_screw_2:screw base.collar:fix.side near=-12.021,12.021,95
concentric collar_screw_3:screw base.collar:fix.side near=-12.021,-12.021,95
concentric collar_screw_4:screw base.collar:fix.side near=12.021,-12.021,95
concentric collar_nut_1:n.side base.collar:fix.side near=12.021,12.021,100
concentric collar_nut_2:n.side base.collar:fix.side near=-12.021,12.021,100
concentric collar_nut_3:n.side base.collar:fix.side near=-12.021,-12.021,100
concentric collar_nut_4:n.side base.collar:fix.side near=12.021,-12.021,100
flush blk_screw_az_1:head.start base.drive.block:spine.start
flush blk_screw_az_2:head.start base.drive.block:spine.start
flush blk_screw_az_3:head.start base.drive.block:spine.start
flush blk_screw_az_4:head.start base.drive.block:spine.start
couple base.drive.spin az ratio=60 lead=3.583 friction=mu module=1/cos(3.583) face=10 pressure=20 gear=base.wheel pinion=base.drive.worm
joint el head.elshaft head.elbox turn about=ea min=-6 max=186 drag=del
couple head.drive.spin el ratio=-60 lead=3.583 friction=mu module=1/cos(3.583) face=10 pressure=20 gear=head.wheel pinion=head.drive.worm
pose az az
pose el el
interference none
interference joint=az steps=18
interference joint=el steps=16
