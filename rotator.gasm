concentric boomclamp_r:small.side elshaft:rod.side
flush shim_l:ring.end boomclamp_l:hub.start
flush shim_r:ring.end boomclamp_r:hub.start
flush boom_l:tube.start boomclamp_l:large.bottom
flush boom_r:tube.start boomclamp_r:large.bottom
flush gland_col:nut.start col.left:shell.end
flush vent_col:nut.start col.left:shell.end
