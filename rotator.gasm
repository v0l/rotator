axis za 0,0,0 0,0,1
axis wa a,0,zw a,1,zw
axis ea 0,0,eh 1,0,eh
axis wea 0,wy,0 0,wy,1
joint az turret bearing_az_low turn about=za min=-270 max=270 at=az
concentric wheel_az:bored.side turret:low.side
flush key_az:k.start turret:keyway.end
joint spin_az worm_az block_az turn about=wa
couple spin_az az ratio=60
flush col.left:<Z turret:disc.end
flush col.right:<Z turret:disc.end
flush col.cord:cord.start col.right:shell.start
flush block_el:spine.end col.left:cav.end
flush brg_a_el:ring.end block_el:seat_a.bottom
flush brg_b_el:ring.start block_el:seat_b.bottom
flush wcollar_el:ring.start brg_b_el:ring.end
flush coupling_el:hub.end brg_a_el:ring.start
flush motor_el:front.end block_el:motor.start
flush enc_el.cap:>Z motor_el:can.start
flush enc_el.pcb:board.start enc_el.cap:posts.end
flush enc_el.magnet:bore.bottom motor_el:tail.end
flush enc_el.disc:mag.end enc_el.magnet:pocket.bottom
concentric rod_el:rod.side coupling_el:bore.side
joint spin_el worm_el block_el turn about=wea
joint el elshaft col.left turn about=ea min=-6 max=186 at=el
couple spin_el el ratio=60
concentric wheel_el:bored.side elshaft:rod.side
flush key_el:k.start elshaft:keyway.end
