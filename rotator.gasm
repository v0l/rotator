concentric boom_nut_l:n.side elshaft:cross.side near=-80,0,eh
flush vring_l:ring.start kfl_l:inner.end
concentric gland_el:stub.side elbox:gland.side
concentric vent_el:stub.side elbox:vent.side
pose az az
pose el el
interference none
interference joint=az steps=18
interference joint=el steps=16
