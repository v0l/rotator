sim static
part elbox_fea.gasm
material box diecast E=71 nu=0.33 yield=160 density=2.7
material lid diecast E=71 nu=0.33 yield=160 density=2.7
mesh 2.5
collar: fix box:collar.side,c1.side
load box:kfl.side force=-76,-158.8,-12.9
load lid:kfl_l.side force=0,344.3,233
load box:drive.side force=91.2,-24.1,-177.3
beside_bearing: probe 1.5,10,128
wall_corner: probe 1.5,45,10
expect beside_bearing.stress<50 displacement<0.5
