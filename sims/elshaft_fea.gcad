let d=12 L=131 bw=2 b1=17.75 b2=97.75 al=8 ar=8 kz=54.5 kl=18 key=4 kd=2.5 k0l=8.5 k2l=8.5
circle d-0.02
arm_l: extrude al
plane arm_l.end
circle d-0.02
s0: extrude b1-bw/2-al
plane s0.end
circle d-0.02
bf: extrude bw
plane bf.end
circle d-0.02
s1: extrude kz+0.5-b1-bw/2
plane s1.end
circle d-0.02
hub: extrude kl-1
plane hub.end
circle d-0.02
s1b: extrude b2-bw/2-kz-kl+0.5
plane s1b.end
circle d-0.02
bl: extrude bw
plane bl.end
circle d-0.02
s2: extrude L-ar-b2-bw/2
plane s2.end
circle d-0.02
arm_r: extrude ar
plane XY offset=kz+kl
rect key kd+1 at=0,d/2-kd/2+0.5
kw: cut kl
plane XY offset=L
rect key kd+1 at=0,d/2-kd/2+0.5
k2: cut k2l
plane XY offset=k0l
rect key kd+1 at=0,d/2-kd/2+0.5
k0: cut k0l
material steel
