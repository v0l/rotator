sim static
let q=680 cda_ant=0.08 cda_boom=0.015 cda_box=0.022 m_head=5 g=9.81 shield=0.5 arm=515 rwheel=30
let zlo=9.6 zup=66.4 zel=226 zw=32 ang=90
let fside=q*(cda_ant+cda_boom)
let fhead=2*fside+q*cda_box
let whead=m_head*g
let taz=fside*(1-shield)*arm/1000
let fworm=taz/rwheel*1000
let fr=fhead*(zel-zlo)/(zup-zlo)+fworm*(zw-zlo)/(zup-zlo)
let fa=whead+10
part kfl002_fea.gcad
mesh 1.2
bolts: fix bolts.side
face: slide flange.start
load seat.side force=fr*cos(ang),fr*sin(ang),fa
hub_side: probe 0,-17.5,6.6
hub_load: probe 0,17.5,6.6
flange_root: probe 0,19.5,3
bolt_web: probe 20,0,3
expect hub_load.stress<70 flange_root.stress<70 displacement<0.05
