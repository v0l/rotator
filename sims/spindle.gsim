sim static
let q=680 cda_ant=0.08 cda_boom=0.015 cda_box=0.022 m_ant=1.0 m_head=5 g=9.81 shield=0.5 arm=515
let fside=q*(cda_ant+cda_boom)
let fhead=2*fside+q*cda_box
let whead=m_head*g
let taz=fside*(1-shield)*arm/1000
part spindle_fea.gcad
material silversteel E=200 nu=0.29 yield=400 density=7.85
mesh 2
lower: pin lo.side
upper: pin up.side
bottom: fix s0.start
load post.end force=0,fhead,-whead
torque post.end taz axis=0,0,1
above_upper: probe 0,-7.3,63
below_collar: probe 0,-7.3,85
keyway_end: probe 0,-7.3,45
expect safety>2 above_upper.stress<150
