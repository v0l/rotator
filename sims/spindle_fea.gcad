let d=15 b0=9.35 b1=58.65 bw=2 c0=87.2 c1=107.2 head=222 kz=23 kl=20
circle d-0.02
s0: extrude b0-bw/2
plane s0.end
circle d-0.02
lo: extrude bw
plane lo.end
circle d-0.02
s1: extrude b1-b0-bw
plane s1.end
circle d-0.02
up: extrude bw
plane up.end
circle d-0.02
s2: extrude c0-b1-bw/2
plane s2.end
circle 44
sleeve: extrude c1-c0
plane sleeve.end
circle 30
post: extrude head-c1
plane XY offset=kz+kl
rect 5 4 at=0,d/2-1.5
kw: cut kl
color #b8bec6
material steel
