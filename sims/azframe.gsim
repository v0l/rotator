sim static
let fhead=144 b0=13.35 b1=62.65 axis=226 taz=16.6 rwheel=30
let rup=fhead*(axis-b0)/(b1-b0)
let rlo=rup-fhead
let fworm=taz/rwheel*1000 zw=32
let fwup=fworm*(zw-b0)/(b1-b0)
let fwlo=fworm-fwup
part azframe.gasm
mesh 7
mast: fix clamp:bore.side
load top:kfl.side force=-fwup,rup,0
load floor:kfl.side force=-fwlo,-rlo,0
load floor:drive.side force=fworm,0,0
post_base: probe -38,-31,8
floor_at_post: probe -38,-31.5,1.5
floor_at_bearing: probe -26.5,-6,1.5
clamp_neck: probe 0,-33.5,-12
expect post_base.stress<70 floor_at_post.stress<50 displacement<0.2
