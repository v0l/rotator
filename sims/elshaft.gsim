sim static
let r=24.04 tl=10.972 tr=-17.353 tw=-(tl+tr)
let ft=tw/r*1000
part elshaft_fea.gcad
material silversteel E=200 nu=0.29 yield=400 density=7.85
mesh 0.8
floor: bearing bf.side axial
lid: bearing bl.side
worm: fix kw.end
load arm_l.side force=-153.4,-113.2,-9.705
torque arm_l.side tl axis=z at=0,0,4
torque arm_l.side -0.6764 axis=y at=0,0,4
load arm_r.side force=237.6,177.8,9.705
torque arm_r.side tr axis=z at=0,0,127
torque arm_r.side 0.0752 axis=y at=0,0,127
load hub.side force=0,ft*tan(20)/cos(3.283),ft*tan(3.283)
at_floor: probe 0,-5.9,17.75
at_lid: probe 0,-5.9,97.75
at_key: probe 4,-4,63.5
at_hub_r: probe 0,-5.9,122
expect at_lid.stress<200 at_key.stress<200 at_hub_r.stress<200
