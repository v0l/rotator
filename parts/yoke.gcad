let xa1=-24.5 xa2=90.5 t=5 Ru=95 r0=-25 w=50 d=12 tb=12.5 ub=15.7 ux1=-10 ux2=80
plane XZ offset=-w/2
pen xa1,r0
line xa1+t,r0
line xa1+t,Ru
line xa2,Ru
line xa2,r0
line xa2+t,r0
line xa2+t,Ru+t
line xa1,Ru+t
close
yoke: extrude w
plane YZ offset=xa1+t
hub_l: hole d+0.04 0,0 depth=t+1
rect 2 4 at=d/2+0.9,0
kw_l: cut t+1
plane YZ offset=xa2+t
hub_r: hole d+0.04 0,0 depth=t+1
rect 2 4 at=d/2+0.9,0
kw_r: cut t+1
plane XY offset=Ru+t
clamp: hole 6.5 ux1,ub ux1,-ub ux2,ub ux2,-ub depth=t+1
color #c4cad1
material aluminium
