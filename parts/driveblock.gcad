let bw=30 back=29 spine=6 pt=9 zb=23 mp=6 zm=-69.5 brg=22 bb=7 pitch=31
plane XY offset=zb
rect bw-1 back+bw/2 at=0,(back-bw/2)/2 r=3
top: extrude pt
plane XY offset=-zb
rect bw-1 back+bw/2 at=0,(back-bw/2)/2 r=3
bottom: extrude -pt
plane XY offset=zm
rect 43 back+21.5 at=0,(back-21.5)/2 r=3
motor: extrude mp
plane XZ offset=-(back-spine)
rect bw zb-zm-mp at=0,(zb+zm+mp)/2
spine: extrude -spine
plane top.end
seat_b: hole brg 0,0 depth=bb
pass: hole 14 0,0
plane bottom.end
seat_a: hole brg 0,0 depth=bb
plane motor.end
pilot: hole 22.4 0,0
mounts: hole 3.4 pitch/2,pitch/2 -pitch/2,pitch/2 -pitch/2,-pitch/2 pitch/2,-pitch/2
plane spine.end
fix: hole 4.5 8,-15 -8,-15 12,-48 -12,-48 depth=spine
color #a9b1ba
material aluminium
