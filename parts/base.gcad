let x0=-70 x1=70 y0=-70 y1=142 H=80 wall=8 floor=12 lid=10 r=20
let cx=(x0+x1)/2 cy=(y0+y1)/2 w=x1-x0 l=y1-y0 wc=x1-wall/2
let brg=35 bb=11 boss=45 bossh=30 col=28 pcd=40
let ubrg=47 ubb=19 uboss=57 udrop=14 lip=120 lipt=4 liph=6
let spig=6 gw=3.2 gd=2 iwid=w-2*wall-0.1 ilen=l-2*wall-0.1 ir=r-wall-0.05
rect w l at=cx,cy r=r
box: extrude H
plane box.end
rect w-2*wall l-2*wall at=cx,cy r=r-wall
pocket: cut H-floor
plane XY offset=floor
circle boss
lower: extrude bossh-floor
plane lower.end
pass: hole col 0,0
seat: hole brg 0,0 depth=bb
plane box.start
mast: hole 5 pcd*cos(45),pcd*sin(45) -pcd*cos(45),pcd*sin(45) -pcd*cos(45),-pcd*sin(45) pcd*cos(45),-pcd*sin(45) depth=10 thread=M6
drive: hole 4.5 31,-45 45,-45 31,5 45,5 cbore=10,5
vent: hole 10.5 -45,-120 depth=floor
plane XY offset=floor
cell: hole 2.5 -48.25,66.5 -11.75,66.5 depth=6 thread=M3
plane box.end
lidfix: hole 3.3 wc,-40 wc,24 wc,88 -wc,-40 -wc,24 -wc,88 30,y1-wall/2 -30,y1-wall/2 30,y0+wall/2 -30,y0+wall/2 depth=10 thread=M4
plane >Y
gland: hole 16.2 40,45 12,45 depth=wall+1
color #a9b1ba
material aluminium
body lid
plane XY offset=H
rect w l at=cx,cy r=r
plate: extrude lid
plane XY offset=H
rect iwid ilen at=cx,cy r=ir
spigot: extrude -(spig-1-gw)
plane XY offset=H-spig+1+gw
rect iwid-2*gd ilen-2*gd at=cx,cy r=ir-gd
groove: extrude -gw
plane XY offset=H-spig+1
rect iwid ilen at=cx,cy r=ir
land: extrude -1
plane land.end
rect iwid-12 ilen-12 at=cx,cy r=ir-6
relief: cut spig-1
plane XY offset=H
circle uboss
drop: extrude -udrop
plane plate.end
circle lip
circle lip-2*lipt
labyrinth: extrude liph
plane plate.end
useat: hole ubrg 0,0 depth=ubb
upass: hole 32 0,0
fix: hole 4.5 wc,-40 wc,24 wc,88 -wc,-40 -wc,24 -wc,88 30,y1-wall/2 -30,y1-wall/2 30,y0+wall/2 -30,y0+wall/2 cbore=8,4.5
color #a9b1ba
material aluminium
body gasket
plane XY offset=H-spig+1+0.1
rect iwid ilen at=cx,cy r=ir
rect iwid-2*gd ilen-2*gd at=cx,cy r=ir-gd
cord: extrude gw-0.2
color #111111
material density=1.2
