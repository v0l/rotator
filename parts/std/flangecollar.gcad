let d=15 hub=30 hl=12 F=50 ft=8 pcd=38 screw=4.2 key=5 t2=2.3 grub=4.2 pin=0 set=1
circle hub
h: extrude hl
plane h.end
circle F
flange: extrude ft
plane flange.end
bore: hole d+0.04 0,0
plane flange.end
if key rect key t2+1 at=0,-(d/2+(t2-1)/2)
if key keyway: cut hl+ft
fix: hole screw pcd/2*cos(45),pcd/2*sin(45) -pcd/2*cos(45),pcd/2*sin(45) -pcd/2*cos(45),-pcd/2*sin(45) pcd/2*cos(45),-pcd/2*sin(45)
if key*set setscrew: hole grub 0,hl/2 on=h.side depth=(hub-d)/2+1 thread=M5
if pin plane XZ offset=-hub/2 rx=180
if pin pinh: hole pin+0.02 0,-hl/2 depth=hub+1
color #3a3d42
material steel
