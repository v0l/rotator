let L=25.5 d=14.5 base=2 wall=2 w=18
body holder
let H=base+d*0.8 o=L/2+wall
plane XZ
poly -o-7,0 o+7,0 o+7,base o,base o,H L/2,H L/2,base -L/2,base -L/2,H -o,H -o,base -o-7,base
plate: extrude w both
plane <Z
fix: hole 3.2 -o-3.5,0 o+3.5,0
color #222326
material abs
body cell
plane YZ offset=-L/2
circle d at=0,base+d/2
cell: extrude L
color #c9a227
material density=2.0
