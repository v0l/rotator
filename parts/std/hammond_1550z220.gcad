let L=222.5 W=146.5 r=6 body=50 lid=32.5 wall=3 floor=3 top=2.5 lwall=4.8
let bx=105 by=67 boss=13 ir=3
let az=0 el=0 xs=40 xe=29.75
body box
rect L W r=r
shell: extrude body
plane shell.end
pen 108.250,-61.371
line 108.250,61.371
arc 99.371,70.250 via=100.404,62.404
line 5.629,70.250
arc -5.629,70.250 via=0,60.500
line -99.371,70.250
arc -108.250,61.371 via=-100.404,62.404
line -108.250,-61.371
arc -99.371,-70.250 via=-100.404,-62.404
line -5.629,-70.250
arc 5.629,-70.250 via=0,-60.500
line 99.371,-70.250
arc 108.250,-61.371 via=100.404,-62.404
close
pocket: cut body-floor
plane shell.end
lidscrew: hole 3.3 bx,by -bx,by 0,by bx,-by -bx,-by 0,-by depth=14 thread=M4
if az plane shell.start
if az mast: hole 6.5 xs+40,0 xs-40,0 xs-28,28 xs+28,28
if az vent: hole 10.5 -102,0 depth=floor+1 thread=M12
if az plane <X
if az gland: hole 16.2 25,30 -25,30 depth=wall+1
if el plane shell.start
if el bearing: hole 20 xe,0
if el kfl: hole 6.5 xe-26.5,0 xe+26.5,0
if el plane <X
if el mount1: hole 6.5 45,11.25 depth=wall+1
if el mount: hole 6.5 -45,11.25 45,36.25 -45,36.25 depth=wall+1
if el plane <Y
if el gland: hole 16.2 -85.25,11.25 depth=wall+1
if el vent: hole 10.5 -90.25,36.25 depth=wall+1 thread=M12
color #b9c0c8
material aluminium
body lid
plane XY offset=body
rect L W r=r
cover: extrude lid
plane XY offset=body rx=180
rect L-2*lwall W-2*lwall r=ir
inside: cut lid-top
plane cover.end
lidhole: hole 4.5 bx,by -bx,by 0,by bx,-by -bx,-by 0,-by csink=8.4,90
if az spindle: hole 20 xs,0
if el plane cover.end
if el bearing: hole 20 xe,0
if el kfl: hole 6.5 xe-26.5,0 xe+26.5,0
color #b9c0c8
material aluminium
