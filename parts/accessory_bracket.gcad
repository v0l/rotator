let zp=60.5 tb=5 yw=26 tw=4 xw0=-48 xw1=50 zt=182 boss=3 rb=3.5
let px=11 pz=178 sx=33.5 sy=37.5 sz=107 sw=27
plane XY offset=zp
rect 35 38 at=19.5,45
base: extrude tb
plane XZ offset=-yw
rect xw1-xw0 zt-zp at=(xw0+xw1)/2,(zp+zt)/2
wall: extrude -tw
plane YZ offset=2
pen yw+tw,zp+tb
line 64,zp+tb
line yw+tw,zp+tb+20
close
gusset_a: extrude 3
plane YZ offset=34
pen yw+tw,zp+tb
line 64,zp+tb
line yw+tw,zp+tb+20
close
gusset_b: extrude 3
plane XZ offset=-(yw+tw)
circle 2*rb at=px-3.5,pz-3.5
circle 2*rb at=px-3.5,pz-61.5
circle 2*rb at=px-52.5,pz-3.5
circle 2*rb at=px-52.5,pz-61.5
bosses: extrude -boss
plane XZ offset=-(yw+tw+boss) rx=180
pi: hole 3.6 px-3.5,-(pz-3.5) px-3.5,-(pz-61.5) px-52.5,-(pz-3.5) px-52.5,-(pz-61.5) depth=boss+tw-1
plane XZ offset=-yw
rect 2.5 5 at=sx-sw/2-3,sz+15
rect 2.5 5 at=sx+sw/2+3,sz+15
rect 2.5 5 at=sx-sw/2-3,sz+55
rect 2.5 5 at=sx+sw/2+3,sz+55
tie: cut tw+1
plane XY offset=zp+tb
mount: hole 3.4 12,40 12,56 27,40 27,56 cbore=6.5,3
color #e0782c
material petg
