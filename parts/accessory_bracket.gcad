let zb=154 tb=5 yw=26 tw=4 xw0=-41 xw1=62 zw=24 boss=3 rb=3.5 rib=40
let px=21 pz=143 sx=40.5 sz=40 sw=27
plane XY offset=zb-tb
rect xw1-xw0 38 at=(xw0+xw1)/2,45
base: extrude tb
plane XZ offset=-yw
rect xw1-xw0 zb-zw at=(xw0+xw1)/2,(zb+zw)/2
wall: extrude -tw
plane YZ offset=xw0
pen yw+tw,zb-tb
line 64,zb-tb
line yw+tw,zb-tb-rib
close
gusset_a: extrude 3
plane YZ offset=xw1-3
pen yw+tw,zb-tb
line 64,zb-tb
line yw+tw,zb-tb-rib
close
gusset_b: extrude 3
plane XZ offset=-(yw+tw)
circle 2*rb at=px-3.5,pz-3.5
circle 2*rb at=px-3.5,pz-61.5
circle 2*rb at=px-52.5,pz-3.5
circle 2*rb at=px-52.5,pz-61.5
circle 2*rb at=px-26.5,pz-3.5
circle 2*rb at=px-26.5,pz-61.5
bosses: extrude -boss
plane XZ offset=-(yw+tw+boss) rx=180
pi: hole 3.6 px-3.5,-(pz-3.5) px-3.5,-(pz-61.5) px-52.5,-(pz-3.5) px-52.5,-(pz-61.5) depth=boss+tw-1
zero: hole 3.6 px-26.5,-(pz-3.5) px-26.5,-(pz-61.5) depth=boss+tw-1
plane XZ offset=-yw
rect 2.5 5 at=sx-sw/2-3,sz+15
rect 2.5 5 at=sx+sw/2+3,sz+15
rect 2.5 5 at=sx-sw/2-3,sz+55
rect 2.5 5 at=sx+sw/2+3,sz+55
tie: cut tw+1
plane XZ offset=-yw
grid: hole 3.4 -31,34 -31,54 -31,94 -31,114 -11,34 -11,54 -11,94 -11,114 9,34 9,54 9,74 9,94 9,114 depth=tw+1
plane XY offset=zb-tb rx=180
mount: hole 4.5 12,-40 12,-56 -13.5,-36 -13.5,-60 depth=tb+1
color #e0782c
material petg
