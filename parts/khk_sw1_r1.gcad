let p=pi/cos(3.583) ha=1 hf=1.25 r=8 face=20 hub=12 bore=8
let ro=r+ha ri=r-hf ta=p/4-ha*tan(20) tf=p/4+hf*tan(20) hd=2*ri-0.1
let c1=360*ta/p c2=360*tf/p rm=(ro+ri)/2 cm=(c1+c2)/2 a0=-180-180*face/p
plane XY offset=-face/2 rz=a0
pen ro*cos(-c1),ro*sin(-c1)
arc ro*cos(c1),ro*sin(c1) via=ro,0
arc ri*cos(c2),ri*sin(c2) via=rm*cos(cm),rm*sin(cm)
arc ri*cos(360-c2),ri*sin(360-c2) via=-ri,0
arc ro*cos(-c1),ro*sin(-c1) via=rm*cos(360-cm),rm*sin(360-cm)
close
circle bore+0.04
worm: extrude face twist=360*face/p
plane XY offset=face/2
circle hd
circle bore+0.06
hub: extrude hub
plane YZ offset=hd/2
setscrew: hole 3.3 0,face/2+hub-5 depth=(hd-bore)/2+1 thread=M4
color #4a4d52
material steel
