let dw=0.03 sx=27 sy=10 zt=222 top=40
part kfl_low parts/std/kfl002.gcad
move kfl_low sx,sy,4
part kfl_up parts/std/kfl002.gcad
rotate kfl_up 180 axis=x
move kfl_up sx,sy,zt-4
part spindle parts/spindle_tube.gcad L=zt+top-5
move spindle sx,sy,5
part wheel parts/khk_cg1_60r1.gcad key=0 pin=4
move wheel sx,sy,28
part vring parts/std/vring.gcad
move vring sx,sy,zt
part collar parts/std/flangecollar.gcad F=44 hub=24 pcd=34 screw=4.5 key=0 pin=4
rotate collar 180 axis=z
move collar sx,sy,zt+top-19.8
part dowel_w parts/std/rod.gcad d=4 L=30
rotate dowel_w -90 axis=x
move dowel_w sx,sy-15,43
part dowel_c parts/std/rod.gcad d=4 L=24
rotate dowel_c -90 axis=x
move dowel_c sx,sy-12,zt+top-13.8
part drive drive.gasm az=0 dw=dw
rotate drive 90 axis=y
rotate drive -90 axis=x
move drive sx,sy+38,33
concentric wheel:bored.side spindle:tube.side
concentric collar:bore.side spindle:tube.side
concentric dowel_w:rod.side wheel:pinh.side
concentric dowel_c:rod.side collar:pinh.side
